APP_NAME=Sketch2Shape AI
APP_VERSION=1.0.0
STORAGE_ROOT=../storage
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=12000
MAX_PROMPT_LENGTH=500
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Official TencentARC/InstantMesh checkout and the python executable of its own
# isolated environment (e.g. ~/miniconda3/envs/instantmesh/bin/python).
# Generation requests are rejected with 503 until both are set and valid.
INSTANTMESH_REPO=
INSTANTMESH_PYTHON=
INSTANTMESH_CONFIG=configs/instant-mesh-large.yaml
INFERENCE_TIMEOUT_SECONDS=1800
# Jobs queued or running at once (the GPU always runs exactly one).
MAX_ACTIVE_JOBS=4
# run.py writes Z-up OBJ; glTF is Y-up. Matches the official InstantMesh app.
MESH_CONVERT_Z_UP=true
MESH_MAX_FACES=2000000
GPU_SAMPLE_INTERVAL_SECONDS=2.0
