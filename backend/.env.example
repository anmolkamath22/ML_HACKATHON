APP_NAME=Sketch2Shape AI
APP_VERSION=0.1.0
STORAGE_ROOT=../storage
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=12000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional dedicated official TencentARC/InstantMesh installation. Keep its
# Python environment isolated from backend/.venv and from base Conda.
INSTANTMESH_REPO=
INSTANTMESH_PYTHON=
INSTANTMESH_CONFIG=configs/instant-mesh-large.yaml
INFERENCE_TIMEOUT_SECONDS=1800
