APP_NAME=Sketch2Shape AI
APP_VERSION=1.1.0
STORAGE_ROOT=../storage
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=12000
MAX_PROMPT_LENGTH=500
# Only needed when the UI runs on a different origin than the API (e.g. a separate dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Official TencentARC/InstantMesh checkout and the python executable of its own
# isolated environment (e.g. ~/miniconda3/envs/instantmesh/bin/python).
# Generate 3D stays disabled until both are set and that environment's PyTorch
# can see a supported NVIDIA (CUDA) GPU.
INSTANTMESH_REPO=
INSTANTMESH_PYTHON=
INSTANTMESH_CONFIG=configs/instant-mesh-large.yaml
INFERENCE_TIMEOUT_SECONDS=1800
# Jobs queued or running at once (the GPU always runs exactly one process).
MAX_ACTIVE_JOBS=4
# run.py writes Z-up OBJ; glTF is Y-up. Matches the official InstantMesh app.
MESH_CONVERT_Z_UP=true
MESH_MAX_FACES=2000000
GPU_SAMPLE_INTERVAL_SECONDS=2.0

# Sketch -> image with Stable Diffusion 1.5 + scribble ControlNet before InstantMesh.
# Runs in the InstantMesh environment (needs diffusers and accelerate there).
# Weights (~3-4 GB) download from Hugging Face on the first run.
CONTROLNET_ENABLED=true
CONTROLNET_PYTHON=
CONTROLNET_BASE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_scribble
CONTROLNET_STEPS=20
CONTROLNET_GUIDANCE=7.5
CONTROLNET_CONDITIONING_SCALE=1.0
# auto: whole pipeline on the GPU from 8 GB VRAM, CPU offload below that.
CONTROLNET_MEMORY=auto
CONTROLNET_TIMEOUT_SECONDS=900
